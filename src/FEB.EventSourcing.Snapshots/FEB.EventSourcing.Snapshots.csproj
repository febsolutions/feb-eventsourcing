<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(FebTargetFrameworks)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Description>Persistent aggregate snapshots for FEB.EventSourcing, generated at compile time from [AutoSnapshot] aggregates. Works with every persistence provider.</Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FEB.EventSourcing.Abstractions\FEB.EventSourcing.Abstractions.csproj" />
      <ProjectReference Include="..\FEB.EventSourcing.StateContracts\FEB.EventSourcing.StateContracts.csproj" />
      <ProjectReference Include="..\FEB.EventSourcing\FEB.EventSourcing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FEB.EventSourcing.Tests" />
    </ItemGroup>
</Project>
