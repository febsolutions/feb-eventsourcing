<?xml version="1.0" encoding="utf-8"?>
<!-- Restores the freshly packed packages from artifacts/packages, in an isolated package
     cache so a stale package with the same version can never be picked up. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/consumer-packages" />
  </config>
</configuration>
